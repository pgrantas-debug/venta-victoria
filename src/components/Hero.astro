---
import { Image } from 'astro:assets';
import hero from '../assets/photos/15-terrace-umbrellas-view.jpg';
import { site } from '../data/content';
---

<section class="relative h-[100svh] min-h-[640px] w-full overflow-hidden">
  <Image
    src={hero}
    alt="Terraza de Venta Victoria con vistas a la sierra de Casares"
    class="absolute inset-0 h-full w-full object-cover"
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    priority
  />
  <div class="absolute inset-0 bg-gradient-to-b from-charcoal/55 via-charcoal/25 to-charcoal/70"></div>

  <!-- Top bar: language switch (left) + hamburger (right) -->
  <div class="absolute inset-x-0 top-0 z-20 flex items-center justify-between px-5 py-5 sm:px-8 sm:py-7">
    <button
      type="button"
      data-lang-toggle
      class="flex h-10 w-10 items-center justify-center rounded-full border border-cream/40 text-sm font-medium tracking-wide text-cream backdrop-blur-sm transition hover:border-cream hover:bg-cream/10"
      aria-label="Cambiar idioma / Switch language"
    >
      <span data-lang-label>EN</span>
    </button>

    <button
      type="button"
      data-menu-open
      class="flex h-10 w-10 items-center justify-center rounded-full border border-cream/40 text-cream backdrop-blur-sm transition hover:border-cream hover:bg-cream/10"
      aria-label="Abrir menú / Open menu"
    >
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0 1H18" stroke="currentColor" stroke-width="1.5"/>
        <path d="M0 7H18" stroke="currentColor" stroke-width="1.5"/>
        <path d="M0 13H18" stroke="currentColor" stroke-width="1.5"/>
      </svg>
    </button>
  </div>

  <!-- Centered content -->
  <div class="relative z-10 flex h-full flex-col items-center justify-center px-6 text-center">
    <div class="mb-5 flex h-16 w-16 items-center justify-center rounded-full border border-gold/70 sm:h-20 sm:w-20">
      <span class="font-display text-2xl tracking-wide text-cream sm:text-3xl">VV</span>
    </div>
    <h1 class="font-display text-4xl leading-[1.05] text-cream sm:text-6xl md:text-7xl">
      {site.name}
    </h1>
    <p class="lang-es mt-4 max-w-md text-balance font-body text-base text-cream/90 sm:text-lg">
      Cocina tradicional en las montañas de Casares
    </p>
    <p class="lang-en mt-4 max-w-md text-balance font-body text-base text-cream/90 sm:text-lg">
      Traditional cooking in the mountains above Casares
    </p>

    <a
      href="#carta"
      class="lang-es mt-9 inline-flex items-center gap-2 border border-cream/70 px-7 py-3 text-sm uppercase tracking-[0.2em] text-cream transition hover:bg-cream hover:text-charcoal"
    >
      Ver la carta
    </a>
    <a
      href="#carta"
      class="lang-en mt-9 inline-flex items-center gap-2 border border-cream/70 px-7 py-3 text-sm uppercase tracking-[0.2em] text-cream transition hover:bg-cream hover:text-charcoal"
    >
      View the menu
    </a>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-7 left-1/2 z-10 -translate-x-1/2 text-cream/70">
    <div class="h-9 w-px animate-pulse bg-cream/50"></div>
  </div>
</section>
