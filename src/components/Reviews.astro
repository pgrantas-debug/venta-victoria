---
import { reviews, site } from '../data/content';
const [featured, ...rest] = reviews;
---

<section id="opiniones" class="bg-cream py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6 sm:px-8">
    <div class="reveal reveal-up mb-14 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-terracotta">
          <span class="lang-es">Quien vuelve, lo cuenta</span>
          <span class="lang-en">The ones who come back, say it best</span>
        </p>
        <h2 class="font-display mt-5 text-4xl text-earth-dark sm:text-5xl">
          {site.googleRating} <span class="text-xl align-top text-charcoal/50">/5</span>
          <span class="mx-3 text-2xl text-charcoal/30">·</span>
          {site.taRating} <span class="text-xl align-top text-charcoal/50">/5</span>
        </h2>
      </div>
      <div class="text-sm text-charcoal/60">
        <p>Google · {site.googleReviewCount} <span class="lang-es">opiniones</span><span class="lang-en">reviews</span></p>
        <p>TripAdvisor · {site.taRank} <span class="lang-es">en Casares</span><span class="lang-en">in Casares</span></p>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-[1.3fr_1fr] md:gap-16">
      <div class="reveal">
        <span class="font-display block text-7xl leading-none text-terracotta/40">&ldquo;</span>
        <p class="font-display -mt-6 text-2xl leading-snug text-charcoal sm:text-3xl">
          {featured.quote.es}
        </p>
        <p class="mt-6 text-sm uppercase tracking-wider text-charcoal/60">
          {featured.author} — {featured.source}
        </p>
      </div>

      <div class="reveal reveal-right space-y-8 border-t border-charcoal/10 pt-8 md:border-t-0 md:border-l md:pl-10 md:pt-0">
        {rest.map((r) => (
          <div>
            <p class="text-lg leading-relaxed text-charcoal/85">{r.quote.es}</p>
            <p class="mt-2 text-xs uppercase tracking-wider text-charcoal/50">{r.author} — {r.source}</p>
          </div>
        ))}
        <p class="pt-2 text-xs italic text-charcoal/40">
          <span class="lang-es">Opiniones mostradas en su idioma original.</span>
          <span class="lang-en">Reviews shown in their original language.</span>
        </p>
      </div>
    </div>
  </div>
</section>
